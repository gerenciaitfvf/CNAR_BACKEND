# Server
PORT=4000
NODE_ENV=development

# CORS: lista de origenes separados por coma. Si se deja vacia, se usa la
# lista por defecto (localhost/127.0.0.1 en puertos comunes + http://13.140.141.86).
# CORS_ORIGINS=http://localhost:5173,http://13.140.141.86

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cnar_pms

# JWT
JWT_SECRET=replace-with-a-very-long-random-string
JWT_EXPIRES_IN=8h

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Auth central (hub_fvf)
AUTH_URL=https://authback.fvf.com.ve/api
AUTH_TOKEN=
AUTH_APP_NAME=CNAR-FVF
# Rol local por defecto para usuarios aprovisionados desde el hub (opcional)
# CNAR_DEFAULT_ROLE_ID=
